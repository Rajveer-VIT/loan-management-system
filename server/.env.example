PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lms
# Use a long random value (>= 32 chars required in production), e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
# Comma-separated allowed browser origins
CLIENT_URL=http://localhost:3000
UPLOAD_DIR=uploads
